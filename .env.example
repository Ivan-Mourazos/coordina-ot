# Copia este fichero a .env.local y rellena las credenciales (NO commitear .env.local).

# Origen de datos: mock (desarrollo sin BD) | rps (SQL Server de RPS, red de oficina o VPN)
DATASOURCE=mock

# SQL Server de RPS (192.168.0.124; OJO: .128 es el servidor de ARCHIVOS, no el de BD).
# La "BD de OT" es la vista dbo.TGM_PENDIENTE_OT y vive DENTRO de RPSNext.
RPS_DB_HOST=
RPS_DB_PORT=1433
RPS_DB_DATABASE=RPSNext
RPS_DB_USER=
RPS_DB_PASSWORD=
# El servidor es SQL Server 2014: su TLS no negocia con Node moderno (socket hang up
# en el handshake) → encrypt=false en red interna/VPN. Si actualizan el servidor, probar true.
RPS_DB_ENCRYPT=false
RPS_DB_TRUST_SERVER_CERTIFICATE=true
# Timeout de consulta en ms (la vista TGM_PENDIENTE_OT tarda 7-15 s según la hora)
RPS_DB_REQUEST_TIMEOUT=60000

# ── Fichaje: escritura en OLANET ────────────────────────────────────────────
# Modo del fichaje: sombra (por defecto) | ensayo | activo
#   · sombra → los bonos se derivan y se acumulan en la cola local, pero NO se
#     escribe nada en OLANET. Se revisan en GET /api/fichaje/cola.
#   · ensayo → se escribe en las tablas REALES, pero los bonos van con
#     traspasado=2, que OLANET no procesa: el tiempo NO llega a RPS. Es la forma
#     de probar contra producción que indicó IT (mejor que una tabla aparte,
#     porque ejercita el camino de verdad).
#   · activo → se escribe y el tiempo sube a RPS.
FICHAJE_OLANET=sombra

# SQL Server de OLANET, donde se graban los tiempos (BD OLANET_TGM_DATOS).
#
# OJO: hay DOS hosts de OLANET y son INDEPENDIENTES, no se sincronizan entre sí
# (confirmado por IT el 2026-08-04):
#   · 192.168.4.113\SQLExpress → el del polígono. Es donde vive el fichaje de
#     Oficina Técnica, así que es el que toca.
#   · 192.168.0.124 → el central (raído/delegaciones). Tiene las mismas tablas
#     pero otros datos; ahí no están los bonos de OT.
# Los dos suben a RPS por su cuenta. Las credenciales deberían valer en ambos.
#
# Credenciales DISTINTAS de las de RPS a propósito: el usuario de lectura no
# debe poder escribir, y el de escritura solo necesita permiso en las tablas
# del fichaje (sch_RPS_bonos, scg_Fases, sch_FasesMov, tgm_fichajes_olanet_ot).
# En modo sombra no hace falta rellenarlas: el pool no llega a abrirse.
# Instancia con nombre (SQLExpress) en puerto TCP fijo 54325, no el 1433.
OLANET_DB_HOST=192.168.4.113
OLANET_DB_PORT=54325
OLANET_DB_DATABASE=OLANET_TGM_DATOS
OLANET_DB_USER=
OLANET_DB_PASSWORD=
OLANET_DB_ENCRYPT=false
OLANET_DB_TRUST_SERVER_CERTIFICATE=true

# Carpeta con los PDF escaneados de pedidos: {carpeta}/{año}/{codigo}.pdf
# El proceso del servidor web necesita permiso de lectura en el share.
# La app elige la variable SEGÚN la plataforma, así el mismo .env.local vale en
# Windows (desarrollo) y Linux (deploy) sin editar nada al cambiar de máquina:
#   · Linux (deploy): RPS_PEDIDOS_PDF_DIR = punto de montaje CIFS.
#   · Windows (dev):  RPS_PEDIDOS_PDF_DIR_WIN = ruta UNC (por VPN).
# Cada una tiene default útil (UNC en Windows, /mnt/rps-pedidos en Linux); rellena
# solo si tu ruta difiere del default.
RPS_PEDIDOS_PDF_DIR=/mnt/rps-pedidos
RPS_PEDIDOS_PDF_DIR_WIN=\\192.168.0.128\RPS\VENTAS\PEDIDOS
